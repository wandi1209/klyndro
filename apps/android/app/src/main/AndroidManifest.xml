<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network transport (M1). No internet access is required or used. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS responses are multicast; without this lock the radio may filter them. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Long-lived connection to a paired device: Android 14+ requires a declared type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The service notification is required by the platform; the permission is user-granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Deliberately NOT declared:
        BIND_NOTIFICATION_LISTENER_SERVICE                        -> M5, user-granted
        Accessibility / clipboard workarounds                     -> see docs/architecture/clipboard.md
      Clipboard access needs no permission: Android gates it by focus instead, not by a grant.
      Declaring permissions before the feature exists would ask users for access the app
      does not yet use.
    -->

    <application
        android:name=".KlyndroApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Klyndro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Klyndro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.KlyndroService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Notification Listener Service (M5) -->
        <service
            android:name=".notifications.KlyndroNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
